#!/bin/bash
#
# workspaces - Workspace Environment Manager
#
# Manages isolated development environments for multiple concurrent workspaces using:
# - Git worktrees in ~/.worktrees/<project>/<workspace> for code isolation
# - Workspace state in ~/.worktrees/config/<project>/<workspace>/ for configuration
# - Pluggable commands for start/attach/stop via environment variables
#
# Environment Variables (with defaults):
#   WORKSPACES_SETUP_CMD   - Command to setup workspace (default: tmux new-session)
#   WORKSPACES_START_CMD   - Command to start workspace (default: tmux new-session)
#   WORKSPACES_ATTACH_CMD  - Command to attach to workspace (default: tmux attach-session)
#   WORKSPACES_STOP_CMD    - Command to stop workspace (default: tmux kill-session)
#   WORKSPACES_CHECK_CMD   - Command to check if running (default: tmux has-session)
#
# Workspace Environment Variables (exported to commands):
#   WORKSPACE_NAME         - Workspace name
#   WORKSPACE_SESSION      - Session identifier (project-workspace)
#   WORKSPACE_DIR          - Worktree directory path
#   WORKSPACE_STATE_DIR    - State/config directory path
#   WORKSPACE_GIT_ROOT     - Main git repository root (for accessing latest scripts)
#   WORKSPACE_ARGS         - Additional arguments passed after --
#
# Usage:
#   new <name> [--branch <branch>] [-- <args>]    # Create worktree
#   start <name> [-- <args>]                       # Start environment
#   attach <name>                                  # Attach (auto-starts if needed)
#   list                                           # List all workspaces
#   stop <name>                                    # Stop environment
#   reset <name>                                   # Reset worktree
#   rm <name>                                      # Remove workspace
#
# Examples:
#   workspaces new feature-auth
#   workspaces start feature-auth -- --port-offset 100
#   workspaces attach feature-auth
#   workspaces list
#
# Bash Completion:
#   For tab completion, add to your shell config (~/.bashrc or ~/.zshrc):
#     source /path/to/synapse/scripts/workspaces-completion.bash
#   For zsh, add bashcompinit before sourcing:
#     autoload -U +X bashcompinit && bashcompinit

set -e

# Script name for display in messages
SCRIPT_NAME="$(basename "$0")"

# Configuration
# Find git root from current working directory
GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || error "Not in a git repository")"
PROJECT_NAME="$(basename "$GIT_ROOT")"
WORKTREES_BASE="$HOME/.worktrees/$PROJECT_NAME"
STATE_DIR="$HOME/.worktrees/config/$PROJECT_NAME"

# Default commands (can be overridden by environment variables)
WORKSPACES_SETUP_CMD="${WORKSPACES_SETUP_CMD:-echo \"No setup command configured\"}"
WORKSPACES_START_CMD="${WORKSPACES_START_CMD:-tmux new-session -d -s \"\$WORKSPACE_SESSION\" -c \"\$WORKSPACE_DIR\"}"
WORKSPACES_ATTACH_CMD="${WORKSPACES_ATTACH_CMD:-tmux attach-session -t \"\$WORKSPACE_SESSION\"}"
WORKSPACES_STOP_CMD="${WORKSPACES_STOP_CMD:-tmux kill-session -t \"\$WORKSPACE_SESSION\"}"
WORKSPACES_CHECK_CMD="${WORKSPACES_CHECK_CMD:-tmux has-session -t \"\$WORKSPACE_SESSION\" 2>/dev/null}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
error() {
    echo -e "${RED}ERROR: $1${NC}" >&2
    exit 1
}

info() {
    echo -e "${BLUE}INFO: $1${NC}"
}

success() {
    echo -e "${GREEN}SUCCESS: $1${NC}"
}

warn() {
    echo -e "${YELLOW}WARNING: $1${NC}"
}

# Get workspace state directory
get_state_dir() {
    local workspace_name=$1
    echo "$STATE_DIR/$workspace_name"
}

# Get worktree directory
get_worktree_dir() {
    local workspace_name=$1
    echo "$WORKTREES_BASE/$workspace_name"
}

# Get session name
get_session_name() {
    local workspace_name=$1
    echo "$PROJECT_NAME-$workspace_name"
}

# Run workspace command in subshell with environment variables
run_workspace_cmd() {
    local workspace_name=$1
    local command="${2:-}"
    local extra_args="${3:-}"

    local session_name=$(get_session_name "$workspace_name")
    local worktree_dir=$(get_worktree_dir "$workspace_name")
    local state_dir=$(get_state_dir "$workspace_name")

    # Run command in subshell with environment variables
    (
        export WORKSPACE_NAME="$workspace_name"
        export WORKSPACE_SESSION="$session_name"
        export WORKSPACE_DIR="$worktree_dir"
        export WORKSPACE_STATE_DIR="$state_dir"
        export WORKSPACE_GIT_ROOT="$GIT_ROOT"
        export WORKSPACE_ARGS="$extra_args"
        
        cd "$WORKSPACE_DIR"
        if [ -n "$command" ]; then
            eval "$command"
        fi
    )
}

# Check if workspace is running
is_workspace_running() {
    local workspace_name=$1
    local session_name=$(get_session_name "$workspace_name")
    tmux -L "$session_name" has-session -t "$session_name" 2>/dev/null
}

# Add worktree to IDE workspace if available
add_to_ide_workspace() {
    local worktree_dir=$1

    # Check for available IDE commands in order of preference
    local ide_cmd=""
    if command -v windsurf >/dev/null 2>&1; then
        ide_cmd="windsurf"
    elif command -v cursor >/dev/null 2>&1; then
        ide_cmd="cursor"
    elif command -v code >/dev/null 2>&1; then
        ide_cmd="code"
    fi

    # Add to workspace if IDE is available
    if [ -n "$ide_cmd" ]; then
        info "Adding worktree to $ide_cmd workspace..."
        if $ide_cmd --add "$worktree_dir" 2>/dev/null; then
            success "Worktree added to $ide_cmd workspace"
        else
            # Silently fail - not critical
            :
        fi
    fi
}

# Command: new - Create worktree
cmd_new() {
    local workspace_name=""
    local branch=""
    local workspace_args=""
    local attach_flag=false
    local rm_flag=false
    local reset_flag=false

    while [[ $# -gt 0 ]]; do
        case $1 in
            --help|-h)
                echo "Usage: $SCRIPT_NAME new <workspace-name> [options] [-- <args>]"
                echo ""
                echo "Create a new workspace (git worktree)"
                echo ""
                echo "Options:"
                echo "  --branch <branch>      Branch to checkout (default: current branch)"
                echo "  --attach               Start and attach to workspace after creation"
                echo "  --rm                   Remove workspace after detaching (requires --attach)"
                echo "  --reset                Delete and recreate workspace if it exists"
                echo "  -- <args>              Arguments to pass to start command"
                echo ""
                echo "Examples:"
                echo "  $SCRIPT_NAME new feature-auth"
                echo "  $SCRIPT_NAME new bugfix --branch main"
                echo "  $SCRIPT_NAME new task -- --port-offset 100"
                echo "  $SCRIPT_NAME new task --attach"
                echo "  $SCRIPT_NAME new task --attach --rm"
                echo "  $SCRIPT_NAME new task --reset --attach"
                exit 0
                ;;
            --branch)
                branch="$2"
                shift 2
                ;;
            --attach)
                attach_flag=true
                shift
                ;;
            --rm)
                rm_flag=true
                attach_flag=true  # --rm implies --attach
                shift
                ;;
            --reset)
                reset_flag=true
                shift
                ;;
            --)
                shift
                workspace_args="$*"
                break
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [ -z "$workspace_name" ]; then
                    workspace_name="$1"
                    shift
                else
                    error "Unexpected argument: $1"
                fi
                ;;
        esac
    done

    if [ -z "$workspace_name" ]; then
        error "Workspace name is required. Usage: $SCRIPT_NAME new <workspace-name>"
    fi

    local state_dir=$(get_state_dir "$workspace_name")
    local worktree_dir=$(get_worktree_dir "$workspace_name")
    local workspace_branch="workspace/$workspace_name"

    # Check if worktree already exists and handle reset
    if [ -d "$worktree_dir" ]; then
        if [ "$reset_flag" = true ]; then
            info "Workspace '$workspace_name' exists, resetting..."

            # Stop if running and wait for it to be fully stopped
                if is_workspace_running "$workspace_name"; then
                    info "Stopping workspace..."
                    run_workspace_cmd "$workspace_name" "$WORKSPACES_STOP_CMD"
                fi

            # Remove worktree first
            info "Removing existing worktree..."
            git -C "$GIT_ROOT" worktree remove "$worktree_dir" --force 2>/dev/null || true

            # Prune worktree references
            git -C "$GIT_ROOT" worktree prune

            # If worktree directory still exists, remove it manually from parent directory
            if [ -d "$worktree_dir" ]; then
                (cd "$(dirname "$worktree_dir")" && rm -rf "$(basename "$worktree_dir")") 2>/dev/null || true
            fi

            # Now delete the branch (should work now that worktree is removed)
            if git -C "$GIT_ROOT" rev-parse --verify "$workspace_branch" >/dev/null 2>&1; then
                info "Deleting branch: $workspace_branch"
                git -C "$GIT_ROOT" branch -D "$workspace_branch"
            fi

            # Remove state
            if [ -d "$state_dir" ]; then
                rm -rf "$state_dir"
            fi

            success "Workspace reset"
        else
            warn "Workspace '$workspace_name' already exists"
            info "To start: $SCRIPT_NAME start $workspace_name"
            info "To attach: $SCRIPT_NAME attach $workspace_name"
            info "To reset: $SCRIPT_NAME new $workspace_name --reset"
            exit 0
        fi
    fi

    # Create state directory and worktrees base directory
    mkdir -p "$state_dir"
    mkdir -p "$WORKTREES_BASE"

    info "Creating git worktree for workspace '$workspace_name'..."

    # Determine base branch
    local base_branch
    if [ -z "$branch" ]; then
        base_branch=$(cd "$GIT_ROOT" && git branch --show-current)
        info "Basing on current branch: $base_branch"
    else
        base_branch="$branch"
        info "Basing on branch: $base_branch"
    fi

    # Check if workspace branch already exists
    if git -C "$GIT_ROOT" rev-parse --verify "$workspace_branch" >/dev/null 2>&1; then
        info "Using existing branch: $workspace_branch"
        git -C "$GIT_ROOT" worktree add "$worktree_dir" "$workspace_branch"
    else
        info "Creating new branch: $workspace_branch (from $base_branch)"
        git -C "$GIT_ROOT" worktree add -b "$workspace_branch" "$worktree_dir" "$base_branch"
    fi

    success "Git worktree created for workspace '$workspace_name'"

    # Add worktree to IDE workspace if available
    add_to_ide_workspace "$worktree_dir"

    # Allow direnv if .envrc exists in worktree
    if [ -f "$worktree_dir/.envrc" ]; then
        if command -v direnv >/dev/null 2>&1; then
            info "Allowing direnv for worktree..."
            (cd "$worktree_dir" && direnv allow)
            success "Direnv allowed"
        fi
    fi

    # Save workspace args if provided
    if [ -n "$workspace_args" ]; then
        echo "$workspace_args" > "$state_dir/args"
        info "Workspace arguments saved: $workspace_args"
    fi

    # Setup workspace dependencies
    info "Setting up workspace dependencies..."
    run_workspace_cmd "$workspace_name" "eval \"$WORKSPACES_SETUP_CMD\""

    success "Workspace '$workspace_name' created successfully"
    echo ""

    # If --attach flag was used, start and attach
    if [ "$attach_flag" = true ]; then
        if [ "$rm_flag" = true ]; then
            info "Starting and attaching to workspace (will be removed after detaching)..."
            cmd_attach "$workspace_name"
            
            # When tmux-dev.sh returns (after detaching), remove the workspace
            info "Removing workspace '$workspace_name'..."
            local worktree_dir=$(get_worktree_dir "$workspace_name")
            local state_dir=$(get_state_dir "$workspace_name")
            
            # Stop workspace if still running
            if is_workspace_running "$workspace_name"; then
                run_workspace_cmd "$workspace_name" "$WORKSPACES_STOP_CMD"
            fi
            
            # Remove git worktree
            if [ -d "$worktree_dir" ]; then
                git -C "$GIT_ROOT" worktree remove "$worktree_dir" --force 2>/dev/null || true
                git -C "$GIT_ROOT" worktree prune 2>/dev/null || true
                if [ -d "$worktree_dir" ]; then
                    (cd "$(dirname "$worktree_dir")" && rm -rf "$(basename "$worktree_dir")") 2>/dev/null || true
                fi
            fi
            
            # Remove state directory
            if [ -d "$state_dir" ]; then
                rm -rf "$state_dir"
            fi
            
            success "Workspace '$workspace_name' removed"
        else
            info "Starting and attaching to workspace..."
            cmd_attach "$workspace_name"
        fi
    else
        info "To start: $SCRIPT_NAME start $workspace_name"
        info "To attach: $SCRIPT_NAME attach $workspace_name"
    fi
}

# Command: start - Start workspace environment
cmd_start() {
    local workspace_name=""
    local workspace_args=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            --help|-h)
                echo "Usage: $SCRIPT_NAME start <workspace-name> [-- <args>]"
                echo ""
                echo "Start workspace environment"
                echo ""
                echo "Options:"
                echo "  -- <args>              Arguments to pass to start command"
                echo ""
                echo "Examples:"
                echo "  $SCRIPT_NAME start feature-auth"
                echo "  $SCRIPT_NAME start task -- --port-offset 100"
                exit 0
                ;;
            --)
                shift
                workspace_args="$*"
                break
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [ -z "$workspace_name" ]; then
                    workspace_name="$1"
                    shift
                else
                    error "Unexpected argument: $1"
                fi
                ;;
        esac
    done

    if [ -z "$workspace_name" ]; then
        error "Workspace name is required. Usage: $SCRIPT_NAME start <workspace-name>"
    fi

    local state_dir=$(get_state_dir "$workspace_name")
    local worktree_dir=$(get_worktree_dir "$workspace_name")

    # Check if worktree exists
    if [ ! -d "$worktree_dir" ]; then
        error "Workspace '$workspace_name' does not exist. Create it with: $SCRIPT_NAME new $workspace_name"
    fi

    # Check if already running
    if is_workspace_running "$workspace_name"; then
        warn "Workspace '$workspace_name' is already running"
        info "To attach: $SCRIPT_NAME attach $workspace_name"
        exit 0
    fi

    # Load saved args if not provided
    if [ -z "$workspace_args" ] && [ -f "$state_dir/args" ]; then
        workspace_args=$(cat "$state_dir/args")
    fi

    # Setup environment and run start command
    info "Starting workspace '$workspace_name'..."
    if [ -n "$workspace_args" ]; then
        info "Arguments: $workspace_args"
    fi
    
    # Start and attach in one command (without --bg flag)
    run_workspace_cmd "$workspace_name" "cd \"$worktree_dir\" && eval \"$WORKSPACES_START_CMD\"" "$workspace_args" 

    success "Workspace '$workspace_name' started"
    info "To attach: $SCRIPT_NAME attach $workspace_name"
}

# Command: attach
cmd_attach() {
    local workspace_name="$1"

    if [ "$workspace_name" = "--help" ] || [ "$workspace_name" = "-h" ]; then
        echo "Usage: $SCRIPT_NAME attach <workspace-name>"
        echo ""
        echo "Attach to a workspace environment"
        echo "- If running: attach immediately"
        echo "- If stopped: start then attach"
        echo "- If doesn't exist: error (use 'new' first)"
        echo ""
        echo "Examples:"
        echo "  $SCRIPT_NAME attach feature-auth"
        exit 0
    fi

    if [ -z "$workspace_name" ]; then
        error "Workspace name is required. Usage: $SCRIPT_NAME attach <workspace-name>"
    fi

    local worktree_dir=$(get_worktree_dir "$workspace_name")

    # Check if workspace exists
    if [ ! -d "$worktree_dir" ]; then
        error "Workspace '$workspace_name' does not exist. Create it first with: $SCRIPT_NAME new $workspace_name"
    fi

    # If not running, start it first and attach
    if ! is_workspace_running "$workspace_name"; then
        info "Workspace '$workspace_name' is not running. Starting..."
        
        # Load saved args if not provided
        local state_dir=$(get_state_dir "$workspace_name")
        local workspace_args=""
        if [ -f "$state_dir/args" ]; then
            workspace_args=$(cat "$state_dir/args")
        fi
        
        info "Starting workspace '$workspace_name'..."
        if [ -n "$workspace_args" ]; then
            info "Arguments: $workspace_args"
        fi
        
        # Start and attach in one command (without --bg flag)
        run_workspace_cmd "$workspace_name" "$WORKSPACES_START_CMD" "$workspace_args"
    fi

    # Attach to workspace
    info "Attaching to workspace '$workspace_name'..."
    run_workspace_cmd "$workspace_name" "$WORKSPACES_ATTACH_CMD"
}

# Command: list
cmd_list() {
    if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        echo "Usage: $SCRIPT_NAME list"
        echo ""
        echo "List all workspaces (running and stopped)"
        exit 0
    fi

    info "Active Workspaces:"
    echo ""

    local found=0

    # Find all workspaces
    if [ -d "$STATE_DIR" ]; then
        for state_dir in "$STATE_DIR"/*; do
            if [ ! -d "$state_dir" ]; then
                continue
            fi

            local workspace_name=$(basename "$state_dir")
            local worktree_dir=$(get_worktree_dir "$workspace_name")

            # Check if worktree exists
            if [ ! -d "$worktree_dir" ]; then
                continue
            fi

            if is_workspace_running "$workspace_name"; then
                found=1
                local session_name=$(get_session_name "$workspace_name")

                # Get current branch
                local branch=$(git -C "$worktree_dir" branch --show-current 2>/dev/null || echo "unknown")

                echo -e "  ${GREEN}●${NC} $workspace_name"
                echo "    Branch: $branch"
                echo "    Session: $session_name"
                echo "    Attach: $SCRIPT_NAME attach $workspace_name"
                echo ""
            fi
        done
    fi

    if [ $found -eq 0 ]; then
        echo "  No running workspaces."
    fi

    # Show stopped workspaces
    echo ""
    info "Stopped Workspaces:"
    echo ""

    local stopped_found=0
    if [ -d "$STATE_DIR" ]; then
        for state_dir in "$STATE_DIR"/*; do
            if [ ! -d "$state_dir" ]; then
                continue
            fi

            local workspace_name=$(basename "$state_dir")
            local worktree_dir=$(get_worktree_dir "$workspace_name")

            # Check if worktree exists
            if [ ! -d "$worktree_dir" ]; then
                continue
            fi

            if ! is_workspace_running "$workspace_name"; then
                stopped_found=1

                # Get current branch
                local branch=$(git -C "$worktree_dir" branch --show-current 2>/dev/null || echo "unknown")

                echo -e "  ${RED}○${NC} $workspace_name"
                echo "    Branch: $branch"
                echo "    Start: $SCRIPT_NAME start $workspace_name"
                echo "    Remove: $SCRIPT_NAME rm $workspace_name"
                echo ""
            fi
        done
    fi

    if [ $stopped_found -eq 0 ]; then
        echo "  No stopped workspaces."
    fi
}

# Command: stop
cmd_stop() {
    local workspace_name=$1

    if [ "$workspace_name" = "--help" ] || [ "$workspace_name" = "-h" ]; then
            echo "Usage: $SCRIPT_NAME stop <workspace-name>"
            echo ""
            echo "Stop a running workspace (preserves worktree)"
            echo ""
            echo "Example:"
            echo "  $SCRIPT_NAME stop feature-auth"
        return
    fi

    if [ -z "$workspace_name" ]; then
        error "Workspace name is required. Usage: $SCRIPT_NAME kill <workspace-name>"
    fi

    if ! is_workspace_running "$workspace_name"; then
        warn "Workspace '$workspace_name' is not running"
        return
    fi

    info "Stopping workspace '$workspace_name'..."

    # Setup environment and run stop command
    run_workspace_cmd "$workspace_name" "$WORKSPACES_STOP_CMD"

    success "Workspace '$workspace_name' stopped"
    info "To restart: $SCRIPT_NAME start $workspace_name"
    info "To remove: $SCRIPT_NAME rm $workspace_name"
}

# Command: reset
cmd_reset() {
    local workspace_name=$1

    if [ "$workspace_name" = "--help" ] || [ "$workspace_name" = "-h" ]; then
        echo "Usage: $SCRIPT_NAME reset <workspace-name>"
        echo ""
        echo "Reset workspace worktree to clean state (discard all changes)"
        echo ""
        echo "Note: Workspace must be stopped before reset"
        echo ""
        echo "Example:"
        echo "  $SCRIPT_NAME reset feature-auth"
        exit 0
    fi

    if [ -z "$workspace_name" ]; then
        error "Workspace name is required. Usage: $SCRIPT_NAME reset <workspace-name>"
    fi

    if is_workspace_running "$workspace_name"; then
        error "Workspace '$workspace_name' is running. Stop it first with: $SCRIPT_NAME stop $workspace_name"
    fi

    local worktree_dir=$(get_worktree_dir "$workspace_name")

    if [ ! -d "$worktree_dir" ]; then
        error "Workspace '$workspace_name' does not exist"
    fi

    warn "This will discard all changes in the worktree for workspace '$workspace_name'"
    read -p "Are you sure? (y/N) " -n 1 -r
    echo

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        info "Reset cancelled"
        exit 0
    fi

    info "Resetting worktree for workspace '$workspace_name'..."

    # Reset git worktree
    git -C "$worktree_dir" reset --hard
    git -C "$worktree_dir" clean -fd

    success "Worktree reset for workspace '$workspace_name'"
    info "Use '$SCRIPT_NAME start $workspace_name' to start with clean worktree"
}

# Command: rm
cmd_rm() {
    local workspace_name=$1

    if [ "$workspace_name" = "--help" ] || [ "$workspace_name" = "-h" ]; then
        echo "Usage: $SCRIPT_NAME rm <workspace-name>"
        echo ""
        echo "Remove workspace completely (stops if running, deletes worktree)"
        echo ""
        echo "Example:"
        echo "  $SCRIPT_NAME rm feature-auth"
        exit 0
    fi

    if [ -z "$workspace_name" ]; then
        error "Workspace name is required. Usage: $SCRIPT_NAME rm <workspace-name>"
    fi

    local worktree_dir=$(get_worktree_dir "$workspace_name")
    local state_dir=$(get_state_dir "$workspace_name")

    if [ ! -d "$worktree_dir" ]; then
        error "Workspace '$workspace_name' does not exist"
    fi

    # Check if running and warn
    if is_workspace_running "$workspace_name"; then
        warn "Workspace '$workspace_name' is currently running. It will be stopped."
    fi

    warn "This will permanently delete workspace '$workspace_name' and its worktree"
    read -p "Are you sure? (y/N) " -n 1 -r
    echo

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        info "Remove cancelled"
        exit 1
    fi

    # Stop workspace if running
    if is_workspace_running "$workspace_name"; then
        info "Stopping workspace '$workspace_name'..."
        run_workspace_cmd "$workspace_name" "$WORKSPACES_STOP_CMD"
    fi

    # Remove git worktree
    if [ -d "$worktree_dir" ]; then
        info "Removing git worktree..."
        git -C "$GIT_ROOT" worktree remove "$worktree_dir" --force 2>/dev/null || true
        # Prune any remaining worktree references
        git -C "$GIT_ROOT" worktree prune 2>/dev/null || true
        # If worktree directory still exists, remove it manually from parent directory
        if [ -d "$worktree_dir" ]; then
            (cd "$(dirname "$worktree_dir")" && rm -rf "$(basename "$worktree_dir")") 2>/dev/null || true
        fi
    fi

    # Remove state directory
    if [ -d "$state_dir" ]; then
        info "Removing workspace state..."
        rm -rf "$state_dir"
    fi

    success "Workspace '$workspace_name' removed completely"
}

# Main
main() {
    local command=$1

    if [ $# -gt 0 ]; then
        shift
    fi

    # Handle global help flag
    if [ "$command" = "--help" ] || [ "$command" = "-h" ] || [ -z "$command" ]; then
        command=""
    fi

    case "$command" in
        new)
            cmd_new "$@"
            ;;
        start)
            cmd_start "$@"
            ;;
        attach)
            cmd_attach "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        stop)
            cmd_stop "$@"
            ;;
        reset)
            cmd_reset "$@"
            ;;
        rm)
            cmd_rm "$@"
            ;;
        *)
            echo "Usage: $SCRIPT_NAME <command> [arguments]"
            echo ""
            echo "Commands:"
            echo "  new <name> [options]                Create workspace worktree"
            echo "  start <name>                        Start workspace environment"
            echo "  attach <name>                       Attach to workspace (auto-starts)"
            echo "  list                                List all workspaces"
            echo "  stop <name>                         Stop workspace environment"
            echo "  reset <name>                        Reset worktree (discard changes)"
            echo "  rm <name>                           Remove workspace completely"
            echo ""
            echo "Environment Variables:"
            echo "  WORKSPACES_SETUP_CMD                Command to setup workspace"
            echo "  WORKSPACES_START_CMD                Command to start workspace"
            echo "  WORKSPACES_ATTACH_CMD               Command to attach to workspace"
            echo "  WORKSPACES_STOP_CMD                 Command to stop workspace"
